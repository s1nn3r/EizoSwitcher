<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\EizoSwitcher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <Version>0.1.0</Version>
    <Product>EizoSwitcher</Product>
    <Authors>Marc Breuer</Authors>
    <Copyright>© 2026 Marc Breuer</Copyright>
    <Description>Switches EIZO color modes and blanks displays depending on running programs and games.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Application.SetColorMode (dark mode) is still marked experimental -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\EizoSwitcher.ico" LogicalName="EizoSwitcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EizoSwitcher.Core\EizoSwitcher.Core.csproj" />
  </ItemGroup>

</Project>
